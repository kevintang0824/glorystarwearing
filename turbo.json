{
  "$schema": "https://turborepo.com/schema.json",
  "remoteCache": {
    "timeout": 600,
    "uploadTimeout": 0
  },
  "globalDependencies": [
    "404.html",
    "*.txt",
    "assets/**",
    "catalog-data/**",
    "index.html",
    "robots.txt",
    "scripts/**",
    "sitemap.xml",
    "vercel.json",
    "wp-content/**",
    "!wp-content/uploads/catalog/**",
    "wp-includes/**",
    "about-glory-star-wear/**",
    "activewear-branding-guide/**",
    "activewear-fabrics/**",
    "activewear-manufacturer-selection-checklist/**",
    "activewear-manufacturing-guides/**",
    "activewear-moq-sampling/**",
    "activewear-quality-control/**",
    "activewear-sets-manufacturer/**",
    "activewear-shipping-guide/**",
    "cookie-policy/**",
    "contact-us/**",
    "custom-activewear-process/**",
    "custom-leggings-manufacturer/**",
    "faq/**",
    "gym-wear-manufacturer/**",
    "privacy-policy/**",
    "private-label-activewear/**",
    "request-a-quote/**",
    "sports-bra-manufacturer/**",
    "support/**",
    "terms-of-use/**",
    "yoga-wear-manufacturer/**"
  ],
  "tasks": {
    "cache-core": {
      "cache": true,
      "inputs": ["catalog-data/**"],
      "outputs": ["public/**", "!public/wp-content/uploads/catalog/**"]
    },
    "cache-media-0": { "cache": true, "inputs": ["catalog-data/**"], "outputs": ["public/wp-content/uploads/catalog/0*/**"] },
    "cache-media-1": { "cache": true, "inputs": ["catalog-data/**"], "outputs": ["public/wp-content/uploads/catalog/1*/**"] },
    "cache-media-2": { "cache": true, "inputs": ["catalog-data/**"], "outputs": ["public/wp-content/uploads/catalog/2*/**"] },
    "cache-media-3": { "cache": true, "inputs": ["catalog-data/**"], "outputs": ["public/wp-content/uploads/catalog/3*/**"] },
    "cache-media-4": { "cache": true, "inputs": ["catalog-data/**"], "outputs": ["public/wp-content/uploads/catalog/4*/**"] },
    "cache-media-5": { "cache": true, "inputs": ["catalog-data/**"], "outputs": ["public/wp-content/uploads/catalog/5*/**"] },
    "cache-media-6": { "cache": true, "inputs": ["catalog-data/**"], "outputs": ["public/wp-content/uploads/catalog/6*/**"] },
    "cache-media-7": { "cache": true, "inputs": ["catalog-data/**"], "outputs": ["public/wp-content/uploads/catalog/7*/**"] },
    "cache-media-8": { "cache": true, "inputs": ["catalog-data/**"], "outputs": ["public/wp-content/uploads/catalog/8*/**"] },
    "cache-media-9": { "cache": true, "inputs": ["catalog-data/**"], "outputs": ["public/wp-content/uploads/catalog/9*/**"] },
    "cache-media-a": { "cache": true, "inputs": ["catalog-data/**"], "outputs": ["public/wp-content/uploads/catalog/a*/**"] },
    "cache-media-b": { "cache": true, "inputs": ["catalog-data/**"], "outputs": ["public/wp-content/uploads/catalog/b*/**"] },
    "cache-media-c": { "cache": true, "inputs": ["catalog-data/**"], "outputs": ["public/wp-content/uploads/catalog/c*/**"] },
    "cache-media-d": { "cache": true, "inputs": ["catalog-data/**"], "outputs": ["public/wp-content/uploads/catalog/d*/**"] },
    "cache-media-e": { "cache": true, "inputs": ["catalog-data/**"], "outputs": ["public/wp-content/uploads/catalog/e*/**"] },
    "cache-media-f": { "cache": true, "inputs": ["catalog-data/**"], "outputs": ["public/wp-content/uploads/catalog/f*/**"] },
    "release": {
      "cache": false,
      "dependsOn": [
        "cache-core",
        "cache-media-0",
        "cache-media-1",
        "cache-media-2",
        "cache-media-3",
        "cache-media-4",
        "cache-media-5",
        "cache-media-6",
        "cache-media-7",
        "cache-media-8",
        "cache-media-9",
        "cache-media-a",
        "cache-media-b",
        "cache-media-c",
        "cache-media-d",
        "cache-media-e",
        "cache-media-f"
      ]
    }
  }
}
