      "destination": "/es/products/nylon-workout-tote-bag-travel-shoulder-bags-for-women-40070/",
      "permanent": true
    },
    {
      "source": "/pt/products/slouch-algod%C3%A3o-scrunch-knee-high-long-socks-40715/",
      "destination": "/pt/products/slouch-cotton-scrunch-knee-high-long-socks-40715/",
