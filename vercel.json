{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/restore-release-cache-with-blog.mjs",
  "outputDirectory": "public",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.glorystarwearing.com"
        }
      ],
      "destination": "https://glorystarwearing.com/",
      "permanent": true
    },
    {
      "source": "/:path*/",
      "has": [
        {
          "type": "host",
          "value": "www.glorystarwearing.com"
        }
      ],
      "destination": "https://glorystarwearing.com/:path*/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.glorystarwearing.com"
        }
      ],
      "destination": "https://glorystarwearing.com/:path*",
      "permanent": true
    },
    {
      "source": "/fr/products/slouch-coton-scrunch-knee-high-long-socks-40715/",
      "destination": "/fr/products/slouch-cotton-scrunch-knee-high-long-socks-40715/",
